<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo si el backend de la demo corre SIN https (en una PC de la red local).
  El build release bloquea http por defecto; esto lo permite únicamente para
  las direcciones listadas. Con un backend en https, este archivo no hace falta.
  Para usarlo: en AndroidManifest.xml, dentro de <application ...>, agregar
    android:networkSecurityConfig="@xml/network_security_config"
  y reemplazar 192.168.0.10 por la IP real de la PC del backend.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.0.10</domain>
    </domain-config>
</network-security-config>
