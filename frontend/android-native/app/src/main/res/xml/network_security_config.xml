<?xml version="1.0" encoding="utf-8"?>
<!--
  El backend se publica con https, por lo que no se permite tráfico en texto
  plano. Si hace falta probar contra un backend local sin https, agregar un
  bloque <domain-config cleartextTrafficPermitted="true"> solo para esa IP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
